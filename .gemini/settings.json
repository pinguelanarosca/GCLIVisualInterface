{
  "mcpServers": {
    "github": {
      "env": {},
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ]
    },
    "exa": {
      "env": {
        "EXA_API_KEY": "$EXA_API_KEY"
      },
      "httpUrl": "https://mcp.exa.ai/mcp",
      "url": "https://mcp.exa.ai/mcp",
      "type": "http",
      "trust": true,
      "headers": {
        "x-api-key": "$EXA_API_KEY"
      }
    }
  },
